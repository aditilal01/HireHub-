# Copy this file to .env in the repository root and replace placeholders.
DB_USERNAME=jobportal
DB_PASSWORD=replace-with-a-strong-database-password
# Generate a random secret of at least 32 bytes (for example: openssl rand -base64 48)
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173

# Optional: enables AI resume analysis and job matching
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
